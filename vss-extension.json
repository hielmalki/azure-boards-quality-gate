{
  "manifestVersion": 1,
  "id": "quality-gate-ai",
  "publisher": "HichamElMalki",
  "version": "0.1.21",
  "name": "QualityGate AI",
  "description": "KI-gestützte Anforderungsqualitätsprüfung für Azure-Boards-Work-Items: Analyse, Fix-Vorschläge und Duplikaterkennung direkt im Work-Item-Formular.",
  "public": false,
  "categories": ["Azure Boards"],
  "targets": [
    { "id": "Microsoft.VisualStudio.Services" }
  ],
  "icons": {
    "default": "web/public/icon.png"
  },
  "files": [
    {
      "path": "web/build",
      "packagePath": "dist",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "quality-gate-ai-work-item-page",
      "type": "ms.vss-work-web.work-item-form-page",
      "targets": ["ms.vss-work-web.work-item-form"],
      "properties": {
        "name": "QualityGate AI",
        "uri": "dist/index.html"
      }
    }
  ],
  "scopes": ["vso.work", "vso.work_write", "vso.profile"]
}
